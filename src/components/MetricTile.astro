---
import type { ProofStatus } from '../data/portfolio';
import StatusPill from './StatusPill.astro';

interface Props {
	k: string;
	v: string;
	note: string;
	status: ProofStatus;
}

const { k, v, note, status } = Astro.props;
---

<div class:list={['metric-tile', status !== 'measured' && 'metric-tile--pending']}>
	<div class="metric-tile__key">
		<span>{k}</span>
		<StatusPill status={status} />
	</div>
	<div class="metric-tile__value">{v}</div>
	<div class="metric-tile__note">{note}</div>
</div>
