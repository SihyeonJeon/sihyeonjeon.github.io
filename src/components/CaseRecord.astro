---
import type { CaseRecord as CaseRecordData } from '../data/portfolio';

interface Props {
	record: CaseRecordData;
}

const { record } = Astro.props;
---

<article class="case-record">
	<div class="case-record__head">
		<div>
			<div class="case-record__meta">
				<span>{record.area}</span>
			</div>
			<h3>{record.name}</h3>
		</div>
		<a class="btn btn-sm btn-ghost" href={record.href}>Open</a>
	</div>

	<div class="case-record__body">
		<dl class="case-record__points">
			<div>
				<dt data-i18n-en="Context" data-i18n-ko="맥락">Context</dt>
				<dd data-i18n-en={record.context} data-i18n-ko={record.ko?.context ?? record.context}>{record.context}</dd>
			</div>
			<div>
				<dt data-i18n-en="Problem" data-i18n-ko="문제">Problem</dt>
				<dd data-i18n-en={record.problem} data-i18n-ko={record.ko?.problem ?? record.problem}>{record.problem}</dd>
			</div>
			<div>
				<dt data-i18n-en="Bottleneck" data-i18n-ko="막힌 지점">Bottleneck</dt>
				<dd data-i18n-en={record.hardPart} data-i18n-ko={record.ko?.hardPart ?? record.hardPart}>{record.hardPart}</dd>
			</div>
			<div>
				<dt data-i18n-en="Fix" data-i18n-ko="해결">Fix</dt>
				<dd data-i18n-en={record.response} data-i18n-ko={record.ko?.response ?? record.response}>{record.response}</dd>
			</div>
			<div>
				<dt data-i18n-en="Result" data-i18n-ko="결과">Result</dt>
				<dd data-i18n-en={record.result} data-i18n-ko={record.ko?.result ?? record.result}>{record.result}</dd>
			</div>
		</dl>

		<div class="case-record__metrics" aria-label={`${record.name} metrics`}>
			{
				record.metrics.map((metric) => (
					<div class="case-record__metric">
						<strong>{metric.value}</strong>
						<span data-i18n-en={metric.label} data-i18n-ko={metric.koLabel ?? metric.label}>{metric.label}</span>
						{metric.help && (
							<small data-i18n-en={metric.help} data-i18n-ko={metric.koHelp ?? metric.help}>{metric.help}</small>
						)}
						{typeof metric.bar === 'number' && (
							<div class="case-record__bar" style={`--bar: ${metric.bar}%`}>
								<span></span>
							</div>
						)}
					</div>
				))
			}
		</div>
	</div>
</article>
