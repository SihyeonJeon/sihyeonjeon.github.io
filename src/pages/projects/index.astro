---
import ProjectRow from '../../components/ProjectRow.astro';
import SectionHead from '../../components/SectionHead.astro';
import { flagshipSystems, supportingArtifacts } from '../../data/portfolio';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Work" description="AI/Data systems work and project artifacts">
	<section class="page-head">
		<div class="shell">
			<div class="label">01 · Work</div>
			<h1>Systems first, artifacts second</h1>
			<p>
				Large problem class, clear failure mode, reproducible result
			</p>
		</div>
	</section>

	<section class="section">
		<div class="shell">
			<SectionHead label="Flagship systems" title="Operational AI/data problems" />
			<div class="projects-list">
				{flagshipSystems.map((project, index) => <ProjectRow project={project} index={index} total={flagshipSystems.length} />)}
			</div>
		</div>
	</section>

	<section class="section section--sunken">
		<div class="shell">
			<SectionHead label="Supporting artifacts" title="Reusable tools and focused models" />
			<div class="projects-list">
				{supportingArtifacts.map((project, index) => <ProjectRow project={project} index={index} total={supportingArtifacts.length} />)}
			</div>
		</div>
	</section>
</BaseLayout>
