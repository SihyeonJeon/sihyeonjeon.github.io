---
import type { CollectionEntry } from 'astro:content';
import { assetSrc } from '../utils/assets';

interface Props {
	post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const cover = assetSrc(post.data.cover);
const date = post.data.pubDate.toLocaleDateString('ko-KR', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
});
---

<a href={`/blog/${post.id}/`} class="post-card">
	{cover && (
		<div class="post-card__media">
			<img src={cover} alt="" loading="lazy" />
		</div>
	)}
	<div class="post-card__meta">
		<time datetime={post.data.pubDate.toISOString()}>{date}</time>
		{post.data.tags[0] && <span>{post.data.tags[0]}</span>}
	</div>
	<h3 class="post-card__title">{post.data.title}</h3>
	<p class="post-card__excerpt">{post.data.description}</p>
</a>
