---
import { SITE_TITLE } from '../consts';
import { profile, publicFlagshipSystems, publicSupportingArtifacts } from '../data/portfolio';
import BaseLayout from '../layouts/BaseLayout.astro';

const toolTax = publicSupportingArtifacts.find((project) => project.slug === 'tool-tax');
const selectedWork = [
	...publicFlagshipSystems.slice(0, 3),
	...(toolTax ? [toolTax] : []),
];
---

<BaseLayout title={SITE_TITLE}>
	<section class="hero">
		<div class="shell">
			<div class="hero__identity">{profile.identity}</div>
			<h1>{profile.motto}</h1>
			<p class="hero__lede">
				{profile.education}
			</p>
			<div class="hero__stack" aria-label="Stack">
				{profile.stack.map((item) => <span>{item}</span>)}
			</div>
			<div class="hero__actions">
				<a class="btn btn-primary" href="/projects/">Work <span aria-hidden="true">→</span></a>
				<a class="btn btn-ghost" href={profile.githubUrl}>GitHub ↗</a>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="shell">
			<div class="section-head section-head--compact">
				<div>
					<div class="section-head__label">Selected Work</div>
					<h2>Projects</h2>
				</div>
			</div>
			<div class="home-work-list">
				{
					selectedWork.map((project, index) => (
						<a class="home-work-row" href={project.href}>
							<span>{String(index + 1).padStart(2, '0')}</span>
							<strong>{project.name}</strong>
							<small>{project.category}</small>
							<em>{project.stat.k}: {project.stat.v}</em>
						</a>
					))
				}
			</div>
		</div>
	</section>
</BaseLayout>
