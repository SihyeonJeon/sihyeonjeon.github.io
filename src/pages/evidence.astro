---
import CaseRecord from '../components/CaseRecord.astro';
import SectionHead from '../components/SectionHead.astro';
import { caseRecords, evidenceRows } from '../data/portfolio';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Records" description="Project records for current AI/Data systems work">
	<section class="page-head">
		<div class="shell">
			<div class="label">02 · Records</div>
			<h1>Problem, fix, result</h1>
			<p>Only the useful parts of each project</p>
		</div>
	</section>

	<section class="section section--sunken">
		<div class="shell">
			<SectionHead label="Case records" title="Short records, visible numbers" />
			<div class="case-records">
				{caseRecords.map((record) => <CaseRecord record={record} />)}
			</div>
		</div>
	</section>

	<section class="section">
		<div class="shell">
			<SectionHead label="Index" title="Repos and reports" />
			<div class="evidence-table" role="table" aria-label="Evidence table">
				<div class="evidence-table__row evidence-table__head" role="row">
					<div role="columnheader">Work</div>
					<div role="columnheader">Result</div>
					<div role="columnheader">Signal</div>
				</div>
				{
					evidenceRows.map((row) => (
						<a class="evidence-table__row" href={row.href} role="row">
							<div role="cell">
								<strong>{row.name}</strong>
								<span>{row.kind}</span>
							</div>
							<div role="cell">{row.result}</div>
							<div role="cell">{row.signal}</div>
						</a>
					))
				}
			</div>
		</div>
	</section>
</BaseLayout>
