---
import { SITE_TITLE } from '../consts';

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="site-header">
	<nav class="site-header__inner" aria-label="Primary navigation">
		<a href="/" class="site-header__brand">{SITE_TITLE}</a>
		<div class="site-header__nav">
			<a href="/projects/" aria-current={isActive('/projects') ? 'page' : undefined}>Projects</a>
			<a href="/blog/" aria-current={isActive('/blog') ? 'page' : undefined}>Blog</a>
			<a href="/about/" aria-current={isActive('/about') ? 'page' : undefined}>About</a>
		</div>
	</nav>
</header>
