---
import ProjectRow from '../../components/ProjectRow.astro';
import SectionHead from '../../components/SectionHead.astro';
import { publicFlagshipSystems, publicSupportingArtifacts } from '../../data/portfolio';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Work" description="AI Engineering and Agentic Systems project records">
	<section class="page-head">
		<div class="shell">
			<div class="label">Work</div>
			<h1>Work</h1>
			<p>
				Project pages, reports, packages, and source repositories
			</p>
		</div>
	</section>

	<section class="section">
		<div class="shell">
			<SectionHead label="Systems" title="AI Engineering · Agentic Systems" />
			<div class="projects-list">
				{publicFlagshipSystems.map((project, index) => <ProjectRow project={project} index={index} total={publicFlagshipSystems.length} />)}
			</div>
		</div>
	</section>

	<section class="section section--sunken">
		<div class="shell">
			<SectionHead label="Artifacts" title="Packages and model surfaces" />
			<div class="projects-list">
				{publicSupportingArtifacts.map((project, index) => <ProjectRow project={project} index={index} total={publicSupportingArtifacts.length} />)}
			</div>
		</div>
	</section>
</BaseLayout>
