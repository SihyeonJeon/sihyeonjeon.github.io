---
import { profile } from '../data/portfolio';

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="site-header">
	<nav class="site-header__inner" aria-label="Primary navigation">
		<a href="/" class="site-header__brand">
			<span class="site-header__dot" aria-hidden="true"></span>
			<span><b>Sihyeon Jeon</b></span>
		</a>
		<div class="site-header__nav">
			<a href="/projects/" aria-current={isActive('/projects') ? 'page' : undefined}>Work</a>
			<a href="/about/" aria-current={isActive('/about') ? 'page' : undefined}>About</a>
		</div>
		<div class="site-header__actions">
			<button class="theme-toggle lang-toggle" type="button" data-lang-toggle aria-label="Toggle language">KO</button>
			<a class="btn btn-sm btn-primary" href={profile.githubUrl}>GitHub</a>
		</div>
	</nav>
</header>
