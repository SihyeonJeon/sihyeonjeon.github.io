---
import { profile } from '../data/portfolio';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About" description="Sihyeon Jeon's portfolio direction and working style">
	<section class="page-head">
		<div class="shell">
			<div class="label">05 · About</div>
			<h1>I build the smallest measurable system that can survive review.</h1>
			<p>{profile.positioning}</p>
		</div>
	</section>

	<section class="section">
		<div class="shell about-grid">
			<div>
				<h2>Current direction</h2>
				<p>
					The portfolio is moving toward AI/Data Systems Engineering: RAG evaluation, model-facing research tools, low-level inference benchmarking, decision optimization, and MLOps/data-quality layers.
				</p>
				<p>
					Existing repos stay visible because they show release discipline. New work must add deeper technical proof: measured benchmarks, design trade-offs, reproducible runs, and failure cases.
				</p>
			</div>
			<aside class="about-side">
				<div>
					<span>Primary</span>
					<strong>AI/Data systems</strong>
				</div>
				<div>
					<span>Secondary</span>
					<strong>Modeling · full-stack · low-level optimization</strong>
				</div>
				<div>
					<span>Proof rule</span>
					<strong>no unmeasured numbers</strong>
				</div>
			</aside>
		</div>
	</section>
</BaseLayout>
