---
import { profile } from '../data/portfolio';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About" description="Sihyeon Jeon profile">
	<section class="page-head">
		<div class="shell">
			<div class="label">About</div>
			<h1>Sihyeon Jeon</h1>
			<p>{profile.identity}</p>
		</div>
	</section>

	<section class="section">
		<div class="shell about-grid">
			<div>
				<h2>{profile.motto}</h2>
				<ul class="plain-list">
					<li>{profile.education}</li>
					<li>{profile.role}</li>
					<li>{profile.positioning}</li>
				</ul>
			</div>
			<aside class="about-side">
				<div>
					<span>Education</span>
					<strong>{profile.education}</strong>
				</div>
				<div>
					<span>Location</span>
					<strong>{profile.location}</strong>
				</div>
				<div>
					<span>Stack</span>
					<strong>{profile.stack.join(' · ')}</strong>
				</div>
				<div>
					<span>GitHub</span>
					<strong>{profile.github}</strong>
				</div>
			</aside>
		</div>
	</section>
</BaseLayout>
