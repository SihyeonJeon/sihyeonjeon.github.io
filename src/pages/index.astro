---
import { getCollection } from 'astro:content';
import PostCard from '../components/PostCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { SITE_TITLE } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 5);

const featured = (await getCollection('projects', ({ data }) => data.featured && !data.draft)).sort(
	(a, b) => a.data.order - b.data.order,
);
---

<BaseLayout title={SITE_TITLE}>
	<section class="hero" aria-labelledby="hero-title">
		<div class="hero__inner">
			<div class="hero__content">
				<span class="hero__eyebrow" aria-hidden="true">Engineer · Researcher · Builder</span>

				<h1 id="hero-title" class="hero__title" lang="ko">
					전시현<span class="hero__title-mark" aria-hidden="true">.</span>
				</h1>

				<p class="hero__lede" lang="ko">
					인공지능과 산업공학의 교차점에서, 시스템을 설계하고 구현합니다.
				</p>

				<p class="hero__sub" lang="ko">
					Multi-agent orchestration harness를 비롯한 응용 사이드 프로젝트와 풀스택 엔지니어링,
					그리고 인공지능 방법론에 대한 글을 이 곳에 정리합니다. 작은 실험들이 큰 시스템으로 수렴하는
					과정을 기록합니다.
				</p>

				<div class="hero__ctas">
					<a class="btn btn-primary" href="/projects/">
						프로젝트 보기
						<svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
							<path
								d="M3 7h8M7 3l4 4-4 4"
								stroke="currentColor"
								stroke-width="1.5"
								stroke-linecap="round"
								stroke-linejoin="round"></path>
						</svg>
					</a>
					<a class="btn btn-secondary" href="/blog/">글 읽기</a>
				</div>
			</div>

			<div class="hero__art" aria-hidden="true">
				<svg
					class="hero__art-svg"
					viewBox="0 0 400 400"
					xmlns="http://www.w3.org/2000/svg"
					role="img"
					focusable="false">
					<title>Convergence — front-end, back-end, system, and AI nodes orbiting a central core.</title>

					<defs>
						<pattern id="hero-grid" x="0" y="0" width="40" height="40" patternUnits="userSpaceOnUse">
							<path d="M40 0H0V40" fill="none" stroke="currentColor" stroke-width="0.4" opacity="0.10"></path>
						</pattern>

						<radialGradient id="hero-core" cx="50%" cy="50%" r="50%">
							<stop offset="0%" stop-color="var(--color-accent)" stop-opacity="0.32"></stop>
							<stop offset="60%" stop-color="var(--color-accent)" stop-opacity="0.08"></stop>
							<stop offset="100%" stop-color="var(--color-accent)" stop-opacity="0"></stop>
						</radialGradient>

						<style>
							.hero__art-svg .breath {
								transform-origin: 200px 200px;
								animation: heroBreath 8s ease-in-out infinite;
							}
							.hero__art-svg .drift-a {
								animation: heroDriftA 14s ease-in-out infinite;
								transform-origin: 200px 200px;
							}
							.hero__art-svg .drift-b {
								animation: heroDriftB 18s ease-in-out infinite;
								transform-origin: 200px 200px;
							}
							@keyframes heroBreath {
								0%,
								100% {
									transform: scale(1);
									opacity: 0.95;
								}
								50% {
									transform: scale(1.025);
									opacity: 1;
								}
							}
							@keyframes heroDriftA {
								0%,
								100% {
									transform: rotate(0deg);
								}
								50% {
									transform: rotate(2deg);
								}
							}
							@keyframes heroDriftB {
								0%,
								100% {
									transform: rotate(0deg);
								}
								50% {
									transform: rotate(-1.5deg);
								}
							}
							@media (prefers-reduced-motion: reduce) {
								.hero__art-svg .breath,
								.hero__art-svg .drift-a,
								.hero__art-svg .drift-b {
									animation: none;
								}
							}
						</style>
					</defs>

					<rect x="0.5" y="0.5" width="399" height="399" rx="6" fill="none" stroke="currentColor" stroke-width="0.6" opacity="0.14"></rect>
					<rect x="0" y="0" width="400" height="400" fill="url(#hero-grid)"></rect>

					<g class="drift-a">
						<circle cx="200" cy="200" r="156" fill="none" stroke="currentColor" stroke-width="0.6" opacity="0.30"></circle>
						<circle cx="200" cy="200" r="112" fill="none" stroke="currentColor" stroke-width="0.6" opacity="0.40" stroke-dasharray="2 4"></circle>
					</g>
					<g class="drift-b">
						<circle cx="200" cy="200" r="74" fill="none" stroke="currentColor" stroke-width="0.6" opacity="0.55"></circle>
					</g>

					<g opacity="0.18" stroke="currentColor" stroke-width="0.6">
						<line x1="200" y1="20" x2="200" y2="380"></line>
						<line x1="20" y1="200" x2="380" y2="200"></line>
						<line x1="62" y1="62" x2="338" y2="338"></line>
						<line x1="62" y1="338" x2="338" y2="62"></line>
					</g>

					<g stroke="currentColor" stroke-width="1" opacity="0.55" fill="none">
						<path d="M200 88 L200 200"></path>
						<path d="M312 200 L200 200"></path>
						<path d="M200 312 L200 200"></path>
						<path d="M88  200 L200 200"></path>
						<path d="M121 121 L200 200"></path>
						<path d="M279 121 L200 200"></path>
						<path d="M279 279 L200 200"></path>
						<path d="M121 279 L200 200"></path>
					</g>

					<circle cx="200" cy="200" r="74" fill="url(#hero-core)"></circle>

					<g class="breath">
						<circle cx="200" cy="200" r="42" fill="var(--color-bg)" stroke="currentColor" stroke-width="1.2"></circle>
						<rect x="178" y="178" width="44" height="44" rx="4" transform="rotate(45 200 200)" fill="var(--color-bg)" stroke="var(--color-primary)" stroke-width="1.4"></rect>
						<circle cx="200" cy="200" r="4" fill="var(--color-accent)"></circle>
					</g>

					<g>
						<circle cx="200" cy="88" r="6" fill="var(--color-bg)" stroke="currentColor" stroke-width="1.2"></circle>
						<circle cx="200" cy="88" r="2.2" fill="currentColor"></circle>
						<circle cx="312" cy="200" r="6" fill="var(--color-bg)" stroke="currentColor" stroke-width="1.2"></circle>
						<rect x="309.5" y="197.5" width="5" height="5" fill="currentColor"></rect>
						<circle cx="200" cy="312" r="6" fill="var(--color-bg)" stroke="currentColor" stroke-width="1.2"></circle>
						<circle cx="200" cy="312" r="2.2" fill="currentColor"></circle>
						<circle cx="88" cy="200" r="6" fill="var(--color-bg)" stroke="currentColor" stroke-width="1.2"></circle>
						<rect x="85.5" y="197.5" width="5" height="5" fill="currentColor" transform="rotate(45 88 200)"></rect>
					</g>

					<g opacity="0.85">
						<circle cx="121" cy="121" r="3.4" fill="var(--color-accent)"></circle>
						<circle cx="279" cy="121" r="3.4" fill="currentColor"></circle>
						<circle cx="279" cy="279" r="3.4" fill="var(--color-accent)"></circle>
						<circle cx="121" cy="279" r="3.4" fill="currentColor"></circle>
					</g>

					<g stroke="currentColor" stroke-width="0.6" opacity="0.45" fill="none">
						<path d="M16 24 V16 H24"></path>
						<path d="M376 16 H384 V24"></path>
						<path d="M384 376 V384 H376"></path>
						<path d="M24 384 H16 V376"></path>
					</g>
				</svg>
			</div>
		</div>
	</section>

	{
		featured.length > 0 && (
			<section class="featured container">
				<h2>주요 작업</h2>
				<div class="project-grid">
					{featured.map((project) => (
						<ProjectCard project={project} />
					))}
				</div>
			</section>
		)
	}

	<section class="recent container">
		<h2>최근 글</h2>
		{
			posts.length > 0 ? (
				<div class="post-list">
					{posts.map((post) => (
						<PostCard post={post} />
					))}
				</div>
			) : (
				<p class="empty-state">첫 글을 준비하고 있습니다.</p>
			)
		}
	</section>
</BaseLayout>
