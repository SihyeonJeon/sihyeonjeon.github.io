---
import { getCollection } from 'astro:content';
import PostCard from '../components/PostCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { SITE_TITLE } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

const featured = (await getCollection('projects', ({ data }) => data.featured && !data.draft)).sort(
	(a, b) => a.data.order - b.data.order,
);
---

<BaseLayout title={SITE_TITLE}>
	<section class="hero hero--portfolio" aria-labelledby="hero-title">
		<div class="hero__inner">
			<div class="hero__content">
				<span class="hero__eyebrow" aria-hidden="true">Agent tooling · Web context · Audio ML</span>

				<h1 id="hero-title" class="hero__title" lang="ko">
					작게 작동하는 도구를 만들고, 검증 가능한 형태로 남깁니다.
				</h1>

				<p class="hero__lede" lang="ko">
					전시현의 프로젝트 포트폴리오와 기술 블로그입니다.
				</p>

				<p class="hero__sub" lang="ko">
					최근 작업은 agent tool schema 비용 측정, 웹사이트 문체/구조 context 파일, 전조 기반 음악 조성 추론 모델입니다.
					각 프로젝트는 설치, 실행, 배포, 검증 표면을 갖추는 방향으로 정리합니다.
				</p>

				<div class="hero__ctas">
					<a class="btn btn-primary" href="/projects/">프로젝트 보기</a>
					<a class="btn btn-secondary" href="/evidence/">검증 표면 보기</a>
				</div>
			</div>

			<div class="proof-panel" aria-label="Portfolio signals">
				<div>
					<span>01</span>
					<strong>PyPI tools</strong>
					<p>agent workflow를 실제 설치 가능한 CLI로 정리</p>
				</div>
				<div>
					<span>02</span>
					<strong>Release assets</strong>
					<p>모델 checkpoint를 작은 repo와 검증 다운로드로 분리</p>
				</div>
				<div>
					<span>03</span>
					<strong>CI surface</strong>
					<p>build, tests, package shape를 공개 repo에서 확인 가능</p>
				</div>
			</div>
		</div>
	</section>

	<section class="featured container-wide">
		<div class="section-heading">
			<p class="section-kicker">Projects</p>
			<h2>최근 포트폴리오 작업</h2>
		</div>
		<div class="project-grid">
			{featured.map((project) => <ProjectCard project={project} />)}
		</div>
	</section>

	<section class="recent container-wide">
		<div class="section-heading">
			<p class="section-kicker">Writing</p>
			<h2>기술 기록</h2>
		</div>
		{
			posts.length > 0 ? (
				<div class="post-list post-list--grid">
					{posts.map((post) => <PostCard post={post} />)}
				</div>
			) : (
				<p class="empty-state">첫 글을 준비하고 있습니다.</p>
			)
		}
	</section>
</BaseLayout>
