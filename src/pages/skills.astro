---
import { profile } from '../data/portfolio';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Stack" description="Recognized stack">
	<section class="page-head">
		<div class="shell">
			<div class="label">Stack</div>
			<h1>Stack</h1>
			<p>
				Recognized public stack
			</p>
		</div>
	</section>

	<section class="section">
		<div class="shell">
			<div class="stack-panel">
				{profile.stack.map((item) => <span>{item}</span>)}
			</div>
		</div>
	</section>
</BaseLayout>
