---
import SectionHead from '../components/SectionHead.astro';
import { evidenceRows } from '../data/portfolio';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Records" description="Project outputs and reported metrics">
	<section class="page-head">
		<div class="shell">
			<div class="label">Records</div>
			<h1>Records</h1>
			<p>Project outputs and reported metrics</p>
		</div>
	</section>

	<section class="section">
		<div class="shell">
			<SectionHead label="Index" title="Repos and reports" />
			<div class="evidence-table" role="table" aria-label="Evidence table">
				<div class="evidence-table__row evidence-table__head" role="row">
					<div role="columnheader">Work</div>
					<div role="columnheader">Result</div>
					<div role="columnheader">Metrics</div>
				</div>
				{
					evidenceRows.map((row) => (
						<a class="evidence-table__row" href={row.href} role="row">
							<div role="cell">
								<strong>{row.name}</strong>
								<span>{row.kind}</span>
							</div>
							<div role="cell">{row.result}</div>
							<div role="cell">{row.signal}</div>
						</a>
					))
				}
			</div>
		</div>
	</section>
</BaseLayout>
