---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const date = (value: Date) =>
	value.toLocaleDateString('en-US', {
		year: 'numeric',
		month: 'short',
		day: 'numeric',
	});
---

<BaseLayout title="Writing" description="Technical notes tied to portfolio evidence">
	<section class="page-head">
		<div class="shell">
			<div class="label">03 · Writing</div>
			<h1>Engineering notes are useful when they point back to shipped work.</h1>
			<p>
				Short technical records for implementation decisions, release structure, measurement discipline, and future AI/Data systems.
			</p>
		</div>
	</section>

	<section class="section">
		<div class="shell">
			{
				posts.length > 0 ? (
					<div class="writing-list">
						{posts.map((post) => (
							<a class="writing-row" href={`/blog/${post.id}/`}>
								<time datetime={post.data.pubDate.toISOString()}>{date(post.data.pubDate)}</time>
								<strong>
									{post.data.title}
									<span>{post.data.description}</span>
								</strong>
								<small>{post.data.tags[0] ?? 'note'}</small>
								<span>read ↗</span>
							</a>
						))}
					</div>
				) : (
					<p class="empty-state">No public posts yet.</p>
				)
			}
		</div>
	</section>
</BaseLayout>
