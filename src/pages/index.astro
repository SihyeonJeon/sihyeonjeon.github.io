---
import { getCollection } from 'astro:content';
import MetricTile from '../components/MetricTile.astro';
import ProjectRow from '../components/ProjectRow.astro';
import SectionHead from '../components/SectionHead.astro';
import { SITE_TITLE } from '../consts';
import { currentArtifacts, focusInitiatives, metrics, profile, skillDomains } from '../data/portfolio';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 4);

const featured = [...focusInitiatives.slice(0, 3), ...currentArtifacts.slice(0, 2)];
const date = (value: Date) =>
	value.toLocaleDateString('en-US', {
		year: 'numeric',
		month: 'short',
		day: 'numeric',
	});
---

<BaseLayout title={SITE_TITLE}>
	<section class="hero">
		<div class="shell">
			<div class="hero__meta">
				<span><b>//</b> portfolio · v2</span>
				<span><b>role:</b> {profile.role}</span>
				<span><b>status:</b> open to AI/Data systems roles</span>
				<span><b>loc:</b> {profile.location}</span>
			</div>
			<h1>
				I build <em>measurable</em> AI and data systems:
				<span>evaluation, modeling, and the product surface around them.</span>
			</h1>
			<p class="hero__lede">
				<strong>{profile.name}</strong> · {profile.nameKo}. {profile.positioning}
			</p>
			<div class="hero__actions">
				<a class="btn btn-primary" href="/projects/">View projects <span aria-hidden="true">→</span></a>
				<a class="btn" href="/evidence/">Evidence surface</a>
				<a class="btn btn-ghost" href={profile.githubUrl}>GitHub ↗</a>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="shell">
			<SectionHead
				label="01 · Evidence snapshot"
				title="The site separates what exists from what is being built."
				right="measured · planned · TBD"
			/>
			<div class="metrics">
				{metrics.map((metric) => <MetricTile {...metric} />)}
			</div>
			<p class="section-note">
				Every claim is tagged. Current public artifacts remain visible; deeper AI/Data systems are shown as planned until their code, benchmark, or demo exists.
			</p>
		</div>
	</section>

	<section class="section">
		<div class="shell">
			<SectionHead
				label="02 · Portfolio direction"
				title="Five systems, one evidence standard."
				right="AI/Data engineering dossier"
			/>
			<div class="projects-list">
				{featured.map((project, index) => <ProjectRow project={project} index={index} total={featured.length} />)}
			</div>
		</div>
	</section>

	<section class="section section--sunken">
		<div class="shell">
			<SectionHead
				label="03 · Writing"
				title="Technical notes tied to the work, not detached essays."
				right="latest public posts"
			/>
			<div class="writing-list">
				{
					posts.map((post) => (
						<a class="writing-row" href={`/blog/${post.id}/`}>
							<time datetime={post.data.pubDate.toISOString()}>{date(post.data.pubDate)}</time>
							<strong>
								{post.data.title}
								<span>{post.data.description}</span>
							</strong>
							<small>{post.data.tags[0] ?? 'note'}</small>
							<span>read ↗</span>
						</a>
					))
				}
			</div>
		</div>
	</section>

	<section class="section">
		<div class="shell">
			<SectionHead
				label="04 · Skill evidence matrix"
				title="Skills are mapped to proof artifacts."
				right="no percentage bars"
			/>
			<div class="skill-domain">
				<h3>{skillDomains[0].name}</h3>
				<p>{skillDomains[0].sub}</p>
				<div class="skill-grid">
					{
						skillDomains[0].items.map((item) => (
							<div class="skill-item">
								<strong>{item.name}</strong>
								<span>{item.ev}</span>
								<small>proof · {item.proof}</small>
							</div>
						))
					}
				</div>
			</div>
			<a class="text-link" href="/skills/">Open full skill matrix →</a>
		</div>
	</section>

	<section class="section section--contact">
		<div class="shell contact-strip">
			<div>
				<div class="label">05 · Contact</div>
				<h2>Reviewing the portfolio? Start with evidence, then GitHub.</h2>
				<p>The site is structured for quick screening first and deeper technical follow-up second.</p>
			</div>
			<div class="contact-strip__actions">
				<a class="btn btn-primary" href={profile.githubUrl}>GitHub profile ↗</a>
				<a class="btn" href="/evidence/">Evidence table</a>
			</div>
		</div>
	</section>
</BaseLayout>
